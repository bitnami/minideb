#!/bin/bash

set -e
set -u
set -o pipefail

DIST=${1:?Specify the distrubution name}
PLATFORM=${2:-amd64}

BASENAME=bitnami/minideb
DOCKER_REGISTRY=${DOCKER_REGISTRY:-"docker.io"}

if [ -n "${DOCKER_PASSWORD:-}" ]; then
    if [ "${DOCKER_REGISTRY}" = "docker.io" ]; then
        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
    else
        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin "${DOCKER_REGISTRY}"
    fi
fi

push() {
    local dist="$1"
    local image="${BASENAME}:${dist}"
    if [ "${DOCKER_REGISTRY}" != "docker.io" ]; then
        image="${DOCKER_REGISTRY}/${image}"
        docker tag "${BASENAME}:${dist}" "${image}"
    fi
    docker push "${image}"
    
    if [ -n "${COSIGN_PRIVATE_KEY:-}" ] && [ -n "${COSIGN_PASSWORD:-}" ]; then
        cosign sign --yes --key env://COSIGN_PRIVATE_KEY "${image}"
    fi
}

push "$DIST-${PLATFORM}"
