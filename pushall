#!/bin/bash

set -e
set -u
set -o pipefail

DISTS="bullseye
bookworm
"
LATEST=bookworm
BASENAME=bitnami/minideb
DOCKER_REGISTRY=${DOCKER_REGISTRY:-"docker.io"}

if [ -n "${DOCKER_PASSWORD:-}" ]; then
    if [ "${DOCKER_REGISTRY}" = "docker.io" ]; then
        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
    else
        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin "${DOCKER_REGISTRY}"
    fi
fi

push() {
    local dist="$1"
    local image="${BASENAME}:${dist}"
    if [ "${DOCKER_REGISTRY}" != "docker.io" ]; then
        image="${DOCKER_REGISTRY}/${image}"
        docker tag "${BASENAME}:${dist}" "${image}"
    fi
    docker push "${image}"
    
    if [ -n "${COSIGN_PRIVATE_KEY:-}" ] && [ -n "${COSIGN_PASSWORD:-}" ]; then
        # We need the digest for cosign sign
        local digest
        digest=$(docker inspect --format='{{index .RepoDigests 0}}' "${image}")
        if [ -n "$digest" ]; then
            cosign sign --yes --key env://COSIGN_PRIVATE_KEY "${digest}"
        else
            echo "Warning: Could not get digest for ${image}, skipping cosign sign"
        fi
    fi
}

for DIST in $DISTS; do
    push "$DIST"
done

docker tag "${BASENAME}:${LATEST}" "${BASENAME}:latest"
if [ "${DOCKER_REGISTRY}" != "docker.io" ]; then
    docker tag "${BASENAME}:${LATEST}" "${DOCKER_REGISTRY}/${BASENAME}:latest"
fi

push latest

# Create and merge a PR to update minideb-extras
CIRCLE_CI_FUNCTIONS_URL=${CIRCLE_CI_FUNCTIONS_URL:-https://raw.githubusercontent.com/bitnami/test-infra/master/circle/functions}
# sc can't follow source as it is a remote file
# shellcheck disable=SC1090
source <(curl -sSL "$CIRCLE_CI_FUNCTIONS_URL")
for DIST in $DISTS; do
    # Use '.RepoDigests 0' for getting Dockerhub repo digest as it was the first pushed
    DIST_REPO_DIGEST=$(docker image inspect --format '{{index .RepoDigests 0}}' "${BASENAME}:${DIST}")
    update_minideb_derived "https://github.com/bitnami/minideb-runtimes" "$DIST" "$DIST_REPO_DIGEST"
done
